{
	"name": "@lawlzer/cashew",
	"version": "0.0.11",
	"description": "A package for automating keyboard, mouse, screen, OCR, and clipboard interactions.",
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "https://github.com/Lawlzer/cashew"
	},
	"license": "ISC",
	"author": "Lawlzer",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"src",
		"dist",
		"build/Release",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "bun run build-parallel.ts",
		"build:clean": "bun run build-parallel.ts --clean",
		"build:cpp": "node-gyp configure && node-gyp build",
		"build:cpp:optimized": "node scripts/build-cpp-optimized.js",
		"build:js": "tsup --config ./.config/tsup.config.ts",
		"build:legacy": "npm run clean && npm run build:types && npm run build:js && npm run build:cpp",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir ./dist",
		"clean": "rimraf ./dist ./build",
		"clean:generated": "node scripts/clean-generated.js",
		"lint": "lint-staged",
		"lint:all": "npm run lint:eslint && npm run lint:prettier",
		"lint:eslint": "eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:commit": "cross-env LINT_STAGED_COMMIT=true eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:debug": "cross-env TIMING=1 eslint --config ./.config/.eslint.config.mjs",
		"lint:prettier": "prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:commit": "cross-env LINT_STAGED_COMMIT=true prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:debug": "prettier --write --config ./.config/.prettierrc.mjs --ignore-path ./.gitignore",
		"pre-commit": "cross-env LINT_STAGED_COMMIT=true lint-staged -c ./.config/lint-staged.config.mjs",
		"prepare": "husky",
		"publish:all": "npm run build && npm run test && npm publish --access=public && echo \"Successfully published to NPM!\"",
		"test": "bun test"
	},
	"prettier": "./.config/.prettierrc.mjs",
	"dependencies": {
		"@lawlzer/utils": "^4.0.2",
		"fs-extra": "^11.3.0",
		"jsonc-parser": "^3.3.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@lawlzer/prettier": "^0.0.4",
		"@types/bun": "^1.2.15",
		"@types/node": "^22.15.29",
		"cross-env": "^7.0.3",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.1.0",
		"ms": "^2.1.3",
		"node-addon-api": "^8.3.1",
		"node-gyp": "^11.2.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"prettier-plugin-packagejson": "^2.5.15",
		"rimraf": "^6.0.1",
		"sharp": "^0.34.2",
		"tesseract.js": "^6.0.1",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	},
	"trustedDependencies": [
		"tesseract.js"
	]
}
