{
	"name": "@lawlzer/cashew",
	"version": "0.0.11",
	"description": "A package for automating keyboard, mouse, screen, OCR, and clipboard interactions.",
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "https://github.com/Lawlzer/cashew"
	},
	"license": "ISC",
	"author": "Lawlzer",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/esm.js",
			"require": "./dist/cjs.js"
		}
	},
	"main": "./dist/cjs.js",
	"module": "./dist/esm.js",
	"types": "./dist/index.d.ts",
	"files": [
		"src",
		"build",
		"dist"
	],
	"scripts": {
		"build": "npm run clean && npm run build:cpp && npm-run-all --parallel build:js build:types",
		"build:cpp": "node-gyp configure && node-gyp build",
		"build:js": "bun build.ts",
		"build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir ./dist --rootDir ./src",
		"clean": "rimraf ./dist build",
		"lint": "lint-staged",
		"lint:all": "npm run lint:eslint && npm run lint:prettier",
		"lint:eslint": "eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:commit": "cross-env LINT_STAGED_COMMIT=true eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:debug": "cross-env TIMING=1 eslint --config ./.config/.eslint.config.mjs",
		"lint:prettier": "prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:commit": "cross-env LINT_STAGED_COMMIT=true prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:debug": "prettier --write --config ./.config/.prettierrc.mjs --ignore-path ./.gitignore",
		"performanceTest": "npm run build && bun run test.ts",
		"pre-commit": "cross-env LINT_STAGED_COMMIT=true lint-staged -c ./.config/lint-staged.config.mjs",
		"prepare": "husky",
		"publish:all": "npm run build && npm publish --access=public && echo \"Successfully published to NPM!\""
	},
	"prettier": "./.config/.prettierrc.mjs",
	"dependencies": {
		"@lawlzer/utils": "^4.0.1",
		"fs-extra": "^11.3.0",
		"jsonc-parser": "^3.3.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@lawlzer/prettier": "^0.0.4",
		"@types/bun": "^1.2.15",
		"@types/ms": "^2.1.0",
		"@types/node": "^22.15.29",
		"@typescript-eslint/parser": "^8.33.1",
		"bun-plugin-dts": "^0.3.0",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.5",
		"eslint": "^9.28.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.1.0",
		"ms": "^2.1.3",
		"node-addon-api": "^8.3.1",
		"node-gyp": "^11.2.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"prettier-plugin-packagejson": "^2.5.15",
		"rimraf": "^6.0.1",
		"sharp": "^0.34.2",
		"tesseract.js": "^6.0.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.1"
	},
	"trustedDependencies": [
		"tesseract.js"
	]
}
